{
  "name": "simpl",
  "displayName": "Simpl",
  "description": "Подсветка и инструменты разработки для языка Simpl",
  "version": "0.2.1",
  "icon": "./icons/simpl-extension.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZolVo-o/simpl.git"
  },
  "publisher": "simpl-lang",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:simpl",
    "onCommand:simpl.run",
    "onCommand:simpl.runWithArguments",
    "onCommand:simpl.compile",
    "onCommand:simpl.compileAs",
    "onCommand:simpl.check",
    "onCommand:simpl.format",
    "onCommand:simpl.doc",
    "onCommand:simpl.new",
    "onCommand:simpl.repl",
    "onCommand:simpl.help",
    "onCommand:simpl.version",
    "onCommand:simpl.disasm",
    "onCommand:simpl.disasmOptions"
  ],
  "contributes": {
    "languages": [
      {
        "id": "simpl",
        "aliases": [
          "Simpl",
          "simpl"
        ],
        "extensions": [
          ".sim",
          ".simpl"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/simpl-extension.png",
          "dark": "./icons/simpl-extension.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "simpl",
        "scopeName": "source.simpl",
        "path": "./syntaxes/simpl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "simpl",
        "path": "./snippets/simpl.json"
      }
    ],
    "commands": [
      {"command": "simpl.run", "title": "Запустить Simpl"},
      {"command": "simpl.runWithArguments", "title": "Запустить Simpl с аргументами"},
      {"command": "simpl.compile", "title": "Компилировать Simpl"},
      {"command": "simpl.compileAs", "title": "Компилировать Simpl в файл…"},
      {"command": "simpl.check", "title": "Проверить файл Simpl"},
      {"command": "simpl.format", "title": "Форматировать файл Simpl"},
      {"command": "simpl.doc", "title": "Извлечь документацию Simpl"},
      {"command": "simpl.new", "title": "Создать проект Simpl"},
      {"command": "simpl.repl", "title": "Открыть Simpl REPL"},
      {"command": "simpl.help", "title": "Справка Simpl CLI"},
      {"command": "simpl.version", "title": "Версия Simpl CLI"},
      {"command": "simpl.disasm", "title": "Показать байткод Simpl"},
      {"command": "simpl.disasmOptions", "title": "Показать байткод Simpl с параметрами"}
    ],
    "keybindings": [
      {
        "command": "simpl.run",
        "key": "f5",
        "when": "editorTextFocus && editorLangId == simpl"
      },
      {
        "command": "simpl.compile",
        "key": "ctrl+b",
        "when": "editorTextFocus && editorLangId == simpl"
      }
    ],
    "problemMatchers": [
      {
        "name": "simpl",
        "owner": "simpl",
        "fileLocation": ["absolute"],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+error:\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": "error",
          "message": 4
        }
      }
    ],
    "configuration": {
      "title": "Simpl",
      "properties": {
        "simpl.path": {
          "type": "string",
          "default": "simpl",
          "description": "Путь к исполняемому файлу Simpl."
        },
        "simpl.autoCompileOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Компилировать файл .sim при сохранении."
        },
        "simpl.showBytecode": {
          "type": "boolean",
          "default": false,
          "description": "Открывать дизассемблированный байткод после компиляции."
        }
      }
    }
  }
}
