      "    ${3:сказать \"нет\"}"
    ],
    "description": "Условный блок"
  },
  "Объявить функцию": {
    "prefix": "функция",
    "body": [
      "функция ${1:имя}(${2:параметр})",
      "    ${3:вернуть параметр}"
    ],
    "description": "Функция с параметром и результатом"
  },
  "Цикл пока": {
    "prefix": "пока",
    "body": [
      "пока ${1:условие}",
      "    ${2:сказать значение}"
