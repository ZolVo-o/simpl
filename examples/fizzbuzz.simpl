# FizzBuzz с вложенными условиями
повторить 15 раз как число
    если число % 15 == 0
        сказать "FizzBuzz"
    иначе
        если число % 3 == 0
            сказать "Fizz"
        иначе
            если число % 5 == 0
                сказать "Buzz"
            иначе
                сказать число
